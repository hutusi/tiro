    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiro/shared": "workspace:*",
    "astro": "^7.2.4",
    "katex": "^0.18.5",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
