---
import Base from "../layouts/Base.astro";
import { STRINGS } from "../lib/strings.ts";

const t = STRINGS.notFound;
---

<Base title={t.title}>
  <div class="mx-auto max-w-md py-24 text-center">
    <p class="font-serif text-6xl font-bold text-ink-faint">404</p>
    <h1 class="mt-4 font-serif text-xl font-bold">{t.title}</h1>
    <p class="mt-2 text-sm text-ink-muted">{t.hint}</p>
    <div class="mt-8 flex justify-center gap-4 text-sm">
      <a
        href="/"
        class="rounded-md border border-line px-4 py-2 transition-colors hover:border-line-strong hover:text-accent"
      >
        {t.home}
      </a>
      <a
        href="/search/"
        class="rounded-md border border-line px-4 py-2 transition-colors hover:border-line-strong hover:text-accent"
      >
        {t.search}
      </a>
    </div>
  </div>
</Base>
