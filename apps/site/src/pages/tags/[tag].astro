---
import ArticleCard from "../../components/ArticleCard.astro";
import Base from "../../layouts/Base.astro";
import { tagIndex } from "../../lib/articles.ts";

export async function getStaticPaths() {
  // Routed by slug, not by the raw tag: `ci/cd` would otherwise emit a page
  // at a path this route's pattern cannot match.
  return (await tagIndex()).map((group) => ({
    params: { tag: group.slug },
    props: { label: group.label, articles: group.articles },
  }));
}

const { label, articles } = Astro.props;
---

<Base title={`#${label}`}>
  <h1 class="mb-6 text-xl font-bold">
    #{label}
    <span class="text-base font-normal text-neutral-500"
      >({articles.length})</span
    >
  </h1>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
</Base>
