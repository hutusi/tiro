---
import ArticleCard from "../../components/ArticleCard.astro";
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

export async function getStaticPaths() {
  const articles = await getArticles();
  const tags = new Set(articles.flatMap((a) => a.frontmatter.tags ?? []));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      articles: articles.filter((a) =>
        (a.frontmatter.tags ?? []).includes(tag),
      ),
    },
  }));
}

const { tag } = Astro.params;
const { articles } = Astro.props;
---

<Base title={`#${tag}`}>
  <h1 class="mb-6 text-xl font-bold">
    #{tag}
    <span class="text-base font-normal text-neutral-500"
      >({articles.length})</span
    >
  </h1>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
</Base>
