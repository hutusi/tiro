---
import Base from "../../layouts/Base.astro";
import { tagIndex } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

const tags = (await tagIndex()).sort(
  (a, b) => b.articles.length - a.articles.length,
);
---

<Base title={STRINGS.tags.title}>
  <h1 class="mb-8 font-serif text-2xl font-bold">{STRINGS.tags.title}</h1>
  <div class="flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <a
          href={`/tags/${tag.slug}/`}
          class="rounded-full border border-line bg-surface-raised px-3 py-1 text-sm text-ink-muted transition-colors hover:border-line-strong hover:text-accent"
        >
          #{tag.label} <span class="text-ink-faint">{tag.articles.length}</span>
        </a>
      ))
    }
  </div>
</Base>
