---
import SitesGallery from "../../components/SitesGallery.astro";
import Base from "../../layouts/Base.astro";
import { slicePage } from "../../lib/pager.ts";
import { getSites } from "../../lib/sites.ts";
import { STRINGS } from "../../lib/strings.ts";

// Page 1 of the gallery (ADR 0055); pages 2..N live in page/[page].astro.
const sites = getSites();
---

<Base title={STRINGS.sites.title} description={STRINGS.sites.tagline}>
  <SitesGallery sites={slicePage(sites, 1)} current={1} total={sites.length} />
</Base>
