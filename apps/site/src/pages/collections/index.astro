---
import CollectionCard from "../../components/CollectionCard.astro";
import Base from "../../layouts/Base.astro";
import { getCollections } from "../../lib/collections.ts";
import { STRINGS } from "../../lib/strings.ts";

const collections = await getCollections();
const t = STRINGS.collections;
---

<Base title={t.title} description={t.intro}>
  <div class="mb-7">
    <h1 class="text-[34px] font-medium tracking-[-0.01em]">{t.title}</h1>
    <p class="mt-2 font-ui text-sm text-ink-mute">{t.intro}</p>
  </div>

  {collections.length === 0 && <p class="text-ink-soft">{t.empty}</p>}

  <ul class="gallery m-0 list-none p-0">
    {
      collections.map((collection) => (
        <CollectionCard collection={collection} />
      ))
    }
  </ul>
</Base>

<style>
  /* `auto-fill` over the library width, like the article cards: one column
     on a phone, two or three on a desktop, four only on the widest setting. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
</style>
