---
import ArticleCard from "../../components/ArticleCard.astro";
import Base from "../../layouts/Base.astro";
import { categoryIndex } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

export async function getStaticPaths() {
  return (await categoryIndex()).map((group) => ({
    params: { category: group.slug },
    props: { label: group.label, articles: group.articles },
  }));
}

const { label, articles } = Astro.props;
---

<Base title={`${STRINGS.categories.title}: ${label}`}>
  <h1 class="mb-6 text-xl font-bold">
    {STRINGS.categories.title} / {label}
    <span class="text-base font-normal text-neutral-500"
      >({articles.length})</span
    >
  </h1>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
</Base>
