---
import ArticleCard from "../../components/ArticleCard.astro";
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

export async function getStaticPaths() {
  const articles = await getArticles();
  const categories = new Set(
    articles.map((a) => a.frontmatter.category).filter((c) => c !== undefined),
  );
  return [...categories].map((category) => ({
    params: { category },
    props: {
      articles: articles.filter((a) => a.frontmatter.category === category),
    },
  }));
}

const { category } = Astro.params;
const { articles } = Astro.props;
---

<Base title={`${STRINGS.categories.title}: ${category}`}>
  <h1 class="mb-6 text-xl font-bold">
    {STRINGS.categories.title} / {category}
    <span class="text-base font-normal text-neutral-500"
      >({articles.length})</span
    >
  </h1>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
</Base>
