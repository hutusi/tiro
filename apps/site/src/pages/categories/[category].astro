---
import Library from "../../components/Library.astro";
import Base from "../../layouts/Base.astro";
import { categoryIndex } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

export async function getStaticPaths() {
  return (await categoryIndex()).map((group) => ({
    params: { category: group.slug },
    props: { label: group.label, articles: group.articles },
  }));
}

const { label, articles } = Astro.props;
const heading = `${STRINGS.categories.title} / ${label}`;
---

<Base title={heading}>
  <Library articles={articles} heading={heading} count={articles.length} />
</Base>
