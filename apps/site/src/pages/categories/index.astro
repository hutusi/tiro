---
import Base from "../../layouts/Base.astro";
import { categoryIndex } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

const categories = (await categoryIndex()).sort(
  (a, b) => b.articles.length - a.articles.length,
);
---

<Base title={STRINGS.categories.title}>
  <h1 class="mb-8 font-serif text-2xl font-bold">{STRINGS.categories.title}</h1>
  <div class="flex flex-wrap gap-3">
    {
      categories.map((category) => (
        <a
          href={`/categories/${category.slug}/`}
          class="rounded-lg border border-rule bg-field px-4 py-2 text-sm transition-colors hover:border-rule hover:text-accent"
        >
          {category.label}{" "}
          <span class="text-ink-soft">({category.articles.length})</span>
        </a>
      ))
    }
  </div>
</Base>
