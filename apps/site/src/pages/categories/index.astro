---
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

const articles = await getArticles();
const counts = new Map<string, number>();
for (const article of articles) {
  const category = article.frontmatter.category;
  if (category !== undefined)
    counts.set(category, (counts.get(category) ?? 0) + 1);
}
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title={STRINGS.categories.title}>
  <h1 class="mb-6 text-xl font-bold">{STRINGS.categories.title}</h1>
  <div class="flex flex-wrap gap-3">
    {
      categories.map(([category, count]) => (
        <a
          href={`/categories/${category}/`}
          class="rounded-lg border border-neutral-200 px-4 py-2 text-sm hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
        >
          {category} <span class="text-neutral-500">({count})</span>
        </a>
      ))
    }
  </div>
</Base>
