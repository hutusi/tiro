---
import Base from "../../layouts/Base.astro";
import { categoryIndex } from "../../lib/articles.ts";
import { STRINGS } from "../../lib/strings.ts";

const categories = (await categoryIndex()).sort(
  (a, b) => b.articles.length - a.articles.length,
);
---

<Base title={STRINGS.categories.title}>
  <h1 class="mb-6 text-xl font-bold">{STRINGS.categories.title}</h1>
  <div class="flex flex-wrap gap-3">
    {
      categories.map((category) => (
        <a
          href={`/categories/${category.slug}/`}
          class="rounded-lg border border-neutral-200 px-4 py-2 text-sm hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
        >
          {category.label}{" "}
          <span class="text-neutral-500">({category.articles.length})</span>
        </a>
      ))
    }
  </div>
</Base>
