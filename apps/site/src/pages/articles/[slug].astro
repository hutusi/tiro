---
import Base from "../../layouts/Base.astro";
import { categoryUrl, getArticles, tagUrl } from "../../lib/articles.ts";
import { buildReaderView } from "../../lib/reader.ts";
import { STRINGS } from "../../lib/strings.ts";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { frontmatter } = article;
const view = buildReaderView(article.body, article.zhBody, article.slug);
const t = STRINGS.article;
const date = frontmatter.clipped_at.slice(0, 10);
// A single pane means no zh.md. Say why when the reason is "it's already in
// the target language" — otherwise it looks identical to a failed translation.
const noTranslationNeeded = view.kind === "single" && frontmatter.lang === "zh";
---

<Base
  title={frontmatter.title}
  description={frontmatter.summary ?? frontmatter.excerpt}
  ogType="article"
>
  <article data-pagefind-body>
    <header class="mb-10 border-b border-line pb-8">
      <h1
        class="font-serif text-3xl font-bold leading-tight tracking-tight sm:text-4xl"
      >
        {frontmatter.title}
      </h1>
      <div
        class="mt-4 flex flex-wrap items-center gap-2 text-sm text-ink-muted"
      >
        <a
          href={frontmatter.url}
          rel="noopener"
          target="_blank"
          class="hover:text-accent hover:underline"
        >
          {t.source} ↗
        </a>
        <span>·</span>
        <span>{frontmatter.domain}</span>
        <span>·</span>
        <span
          >{t.clippedAt}
          <time datetime={frontmatter.clipped_at}>{date}</time></span
        >
        {
          frontmatter.category !== undefined && (
            <a
              href={categoryUrl(frontmatter.category)}
              data-pagefind-meta={`category:${frontmatter.category}`}
              class="rounded-full bg-accent-soft px-2 py-0.5 text-xs text-accent transition-colors hover:bg-accent hover:text-surface-raised"
            >
              {frontmatter.category}
            </a>
          )
        }
        {
          (frontmatter.tags ?? []).map((tag) => (
            <a href={tagUrl(tag)} class="text-xs hover:text-accent">
              #{tag}
            </a>
          ))
        }
      </div>
      {
        frontmatter.summary !== undefined && (
          <div class="mt-5 rounded-lg border-l-2 border-accent bg-accent-soft/50 p-4 text-sm leading-relaxed text-ink">
            <span class="font-semibold text-accent">{t.summary}：</span>
            {frontmatter.summary}
          </div>
        )
      }
    </header>

    {
      view.kind === "paired" && (
        <div>
          <div
            class="mb-8 inline-flex rounded-lg border border-line bg-surface-raised p-0.5 text-sm"
            id="view-toggle"
            role="group"
          >
            <button
              type="button"
              data-view="both"
              class="rounded-md px-3 py-1 text-ink-muted transition-colors"
            >
              {t.sideBySide}
            </button>
            <button
              type="button"
              data-view="original"
              class="rounded-md px-3 py-1 text-ink-muted transition-colors"
            >
              {t.original}
            </button>
            <button
              type="button"
              data-view="translation"
              class="rounded-md px-3 py-1 text-ink-muted transition-colors"
            >
              {t.translation}
            </button>
          </div>
          <div id="reader" data-mode="both" class="space-y-6">
            {view.rows.map((row) => (
              <div class="reader-row grid gap-x-12 gap-y-2 lg:grid-cols-2">
                <div
                  class="pane-original prose max-w-none"
                  lang={frontmatter.lang}
                  set:html={row.original}
                />
                <div
                  class="pane-translation prose max-w-none"
                  lang="zh-CN"
                  set:html={row.translation}
                />
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      view.kind === "single" && (
        <Fragment>
          {noTranslationNeeded && (
            <p class="mb-6 text-sm text-ink-muted" data-pagefind-ignore>
              {t.noTranslation}
            </p>
          )}
          <div class="prose mx-auto max-w-3xl" lang={frontmatter.lang}>
            {view.blocks.map((html) => (
              <Fragment set:html={html} />
            ))}
          </div>
        </Fragment>
      )
    }

    {
      view.kind === "stacked" && (
        <div class="space-y-10">
          <p class="text-sm text-amber-700 dark:text-amber-500">
            {t.misaligned}
          </p>
          <div class="prose mx-auto max-w-3xl" lang={frontmatter.lang}>
            {view.original.map((html) => (
              <Fragment set:html={html} />
            ))}
          </div>
          <div class="prose mx-auto max-w-3xl" lang="zh-CN">
            {view.translation.map((html) => (
              <Fragment set:html={html} />
            ))}
          </div>
        </div>
      )
    }
  </article>
</Base>

<style>
  #reader[data-mode="original"] .pane-translation {
    display: none;
  }
  #reader[data-mode="translation"] .pane-original {
    display: none;
  }
  /* 48rem must stay in sync with the max-w-3xl on the single/stacked roots. */
  #reader[data-mode="original"] .reader-row,
  #reader[data-mode="translation"] .reader-row {
    grid-template-columns: 1fr;
    max-width: 48rem;
    margin-inline: auto;
  }
  /* In single-pane modes the pair grouping is meaningless — tighten the
     space-y-6 back to paragraph rhythm (the ID out-specifies its :where()). */
  #reader[data-mode="original"] > :not(:last-child),
  #reader[data-mode="translation"] > :not(:last-child) {
    margin-block-end: 1.25rem;
  }
  /* Per-block prose roots suppress prose's own heading margins; give rows
     that open a section their breathing room back. */
  #reader > :global(.reader-row:has(h2, h3):not(:first-child)) {
    margin-top: 2rem;
  }
  /* Raw tokens (--surface/--accent), not --color-*: `@theme inline`
     substitutes the --color-* names away at build time. */
  #view-toggle button[aria-pressed="true"] {
    background-color: var(--surface);
    color: var(--accent);
    font-weight: 500;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }
</style>

<script is:inline>
  const reader = document.getElementById("reader");
  const toggle = document.getElementById("view-toggle");
  if (reader !== null && toggle !== null) {
    const buttons = toggle.querySelectorAll("button");
    const apply = (mode) => {
      reader.dataset.mode = mode;
      for (const b of buttons)
        b.setAttribute("aria-pressed", String(b.dataset.view === mode));
      localStorage.setItem("tiro-reader-mode", mode);
    };
    for (const b of buttons)
      b.addEventListener("click", () => apply(b.dataset.view));
    apply(localStorage.getItem("tiro-reader-mode") ?? "both");
  }
</script>
