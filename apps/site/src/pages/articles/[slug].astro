---
import "katex/dist/katex.min.css";
import FontSteps from "../../components/FontSteps.astro";
import Base from "../../layouts/Base.astro";
import { articleMeta } from "../../lib/article-meta.ts";
import {
  articleUrl,
  categoryPageUrl,
  getAllArticles,
  shortLinks,
  tagPageUrl,
} from "../../lib/articles.ts";
import { shortPathForSlug } from "../../lib/short-links.ts";
import { buildReaderView, skipsLiftedH1 } from "../../lib/reader.ts";
import { scopedAnchorId } from "../../lib/render.ts";
import { dateLabel, minutesLabel, STRINGS } from "../../lib/strings.ts";
import { isUnlisted } from "../../lib/visibility.ts";

export async function getStaticPaths() {
  // Every article, unlisted ones included: the flag removes an article from
  // the lists, not from the site — its URL has to keep working.
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { frontmatter } = article;
const view = buildReaderView(article.body, article.zhBody, article.slug, {
  inlineMath: frontmatter.has_math === true,
});
const meta = articleMeta(article);
const t = STRINGS.article;
// A single pane means no zh.md. Say why when the reason is "it's already in
// the target language" — otherwise it looks identical to a failed translation.
const noTranslationNeeded = view.kind === "single" && frontmatter.lang === "zh";
// The title block shows the title; a body that opens with the same H1 would
// show it twice, so that first block is skipped (stacked view never skips —
// it is the degraded mode and stays dumb).
//
// One flag, because two things hang off it and they must agree: the row that
// is dropped, and the anchors the title block re-emits on its behalf. Stacked
// keeps the row, so the anchors are already on the page — emitting them in the
// title too put two copies of every id in one document, which is the collision
// pane scoping exists to prevent.
const skipsH1 = skipsLiftedH1(view.kind, meta.liftedH1);
const rows =
  view.kind === "paired" ? (skipsH1 ? view.rows.slice(1) : view.rows) : [];
const blocks =
  view.kind === "single" ? (skipsH1 ? view.blocks.slice(1) : view.blocks) : [];
const titleAnchors = skipsH1 ? meta.titleAnchors : [];
const titleZhAnchors = skipsH1 ? meta.titleZhAnchors : [];
const hasZhTitle = meta.titleZh !== null;
// One expression feeds both markers: the in-page one the pane rules read, and
// the `<html>` one that switches `--w-page`, the content measure, which is a
// page-level token and so lives at the root. The chrome reads neither — it
// keeps a fixed gutter (ADR 0021).
const paired = view.kind === "paired";
// Absolute, and against Astro.site rather than the dev origin: what this hands
// someone has to work away from the machine that copied it. Falls back to the
// long URL for an article with no short id — offering a link that does not
// resolve would be worse than offering a long one that does.
const shareUrl = new URL(
  shortPathForSlug(await shortLinks(), article.slug) ?? articleUrl(article),
  Astro.site,
).href;
// The title someone reading this site would recognise.
const shareTitle = meta.titleZh ?? frontmatter.title;
const date = dateLabel(frontmatter.clipped_at);
// An unlisted article drops the `data-pagefind-body` that would otherwise put
// it in the search index. That alone is not enough: Pagefind restricts indexing
// to `data-pagefind-body` elements only while at least one page on the site has
// one, so in a vault where every article is unlisted it falls back to indexing
// every page's whole <body> — which indexed the hidden article's URL and title
// even with this element ignored. `noindex` below puts the ignore on <body>,
// where it covers the page rather than one element of it.
const unlisted = isUnlisted(frontmatter);
// Term routes are built from the listed articles only, so a tag or category
// nothing else carries has no page and must be shown as plain text rather than
// linked into a 404. Every listed article's terms resolve, so in practice this
// only ever degrades an unlisted article's.
const categoryHref =
  frontmatter.category === undefined
    ? null
    : await categoryPageUrl(frontmatter.category);
const tagLinks = await Promise.all(
  (frontmatter.tags ?? []).map(async (tag) => ({
    tag,
    href: await tagPageUrl(tag),
  })),
);
---

<Base
  title={frontmatter.title}
  description={frontmatter.summary ?? frontmatter.excerpt}
  ogType="article"
  width="reader"
  paired={paired}
  noindex={unlisted}
>
  <article
    data-pagefind-body={unlisted ? undefined : true}
    class="reader"
    data-paired={paired ? "" : undefined}
    data-zh-title={hasZhTitle ? "" : undefined}
  >
    <div class="toolbar" data-pagefind-ignore>
      <a href="/" class="back">{t.back}</a>
      {
        view.kind === "paired" && (
          <Fragment>
            <span class="divider" aria-hidden="true" />
            <div
              id="view-toggle"
              class="segmented segmented--md"
              role="group"
              aria-label={t.layoutLabel}
            >
              <button type="button" data-view="both" aria-pressed="false">
                {t.sideBySide}
              </button>
              <button
                type="button"
                data-view="translation"
                aria-pressed="false"
                lang="zh-CN"
              >
                {t.translation}
              </button>
              <button type="button" data-view="original" aria-pressed="false">
                {t.original}
              </button>
            </div>
          </Fragment>
        )
      }
      <span class="divider" aria-hidden="true"></span>
      <FontSteps />
      <div
        class="share"
        data-share-url={shareUrl}
        data-share-title={shareTitle}
      >
        <button type="button" class="chip" data-share hidden>{t.share}</button>
        <button
          type="button"
          class="chip"
          data-copy
          data-idle={t.copyLink}
          data-done={t.copied}
          data-failed={t.copyFailed}
          aria-live="polite">{t.copyLink}</button
        >
        <a
          class="chip source"
          href={frontmatter.url}
          target="_blank"
          rel="noopener"
          aria-label={`${t.openSource}：${frontmatter.domain}`}
          title={frontmatter.domain}
          ><span class="source-name">{frontmatter.domain}</span><span
            aria-hidden="true">↗</span
          ></a
        >
      </div>
    </div>

    <header class="head measure">
      <div class="titles">
        <div class="orig">
          <p class="meta">
            <a
              href={frontmatter.url}
              rel="noopener"
              target="_blank"
              data-pagefind-meta="domain">{frontmatter.domain}</a
            >
            {
              frontmatter.author !== undefined && (
                <Fragment>
                  <span aria-hidden="true">·</span>
                  <span>{frontmatter.author}</span>
                </Fragment>
              )
            }
            <span aria-hidden="true">·</span>
            <span>{minutesLabel(meta.minutes)}</span>
            {unlisted && <span class="pill">{t.unlisted}</span>}
          </p>
          <h1 data-pagefind-meta="title">
            {
              titleAnchors.map((id) => (
                <span id={scopedAnchorId(id, "original")} />
              ))
            }{frontmatter.title}
          </h1>
          <time
            hidden
            datetime={frontmatter.clipped_at}
            data-pagefind-meta="date">{date}</time
          >
          {
            meta.summaryOrig !== null && (
              <p class="lead lead-orig" lang={frontmatter.lang}>
                <span class="lead-label">{t.summaryOriginal}</span>
                {meta.summaryOrig}
              </p>
            )
          }
        </div>
        {
          (hasZhTitle || frontmatter.summary !== undefined) && (
            <div class="zh" lang="zh-CN">
              {hasZhTitle && (
                <h1 class="title-zh" data-pagefind-meta="title_zh">
                  {titleZhAnchors.map((id) => (
                    <span id={scopedAnchorId(id, "translation")} />
                  ))}
                  {meta.titleZh}
                </h1>
              )}
              {frontmatter.summary !== undefined && (
                <p class="lead">
                  <span class="lead-label">{t.summary}</span>
                  {frontmatter.summary}
                </p>
              )}
            </div>
          )
        }
      </div>
      {
        (frontmatter.category !== undefined ||
          (frontmatter.tags ?? []).length > 0) && (
          <p class="terms">
            {frontmatter.category !== undefined &&
              (categoryHref === null ? (
                <span
                  class="pill"
                  data-pagefind-meta={`category:${frontmatter.category}`}
                >
                  {frontmatter.category}
                </span>
              ) : (
                <a
                  href={categoryHref}
                  class="pill"
                  data-pagefind-meta={`category:${frontmatter.category}`}
                >
                  {frontmatter.category}
                </a>
              ))}
            {tagLinks.map(({ tag, href }) =>
              href === null ? <span>#{tag}</span> : <a href={href}>#{tag}</a>,
            )}
          </p>
        )
      }
      <hr class="title-rule" />
    </header>

    {
      view.kind === "paired" && (
        <div id="reader" class="measure">
          {rows.map((row) => (
            <div class="reader-row">
              <div
                class="pane-original prose max-w-none min-w-0"
                lang={frontmatter.lang}
                set:html={row.original}
              />
              <div
                class="pane-translation prose max-w-none min-w-0"
                lang="zh-CN"
                set:html={row.translation}
              />
            </div>
          ))}
        </div>
      )
    }

    {
      view.kind === "single" && (
        <div class="reader-single measure">
          {noTranslationNeeded && (
            <p class="notice" data-pagefind-ignore>
              {t.noTranslation}
            </p>
          )}
          <div class="prose max-w-none" lang={frontmatter.lang}>
            {blocks.map((html) => (
              <Fragment set:html={html} />
            ))}
          </div>
        </div>
      )
    }

    {
      view.kind === "stacked" && (
        <div class="reader-single measure space-y-10">
          <p class="notice notice--warn">{t.misaligned}</p>
          <div class="prose max-w-none" lang={frontmatter.lang}>
            {view.original.map((html) => (
              <Fragment set:html={html} />
            ))}
          </div>
          <div class="prose max-w-none" lang="zh-CN">
            {view.translation.map((html) => (
              <Fragment set:html={html} />
            ))}
          </div>
        </div>
      )
    }

    <p class="end-note measure" data-pagefind-ignore>
      {t.clippedAt}
      <time datetime={frontmatter.clipped_at}>{date}</time>
      <span aria-hidden="true">·</span>
      {t.publishedAt}
      <a href={frontmatter.url} rel="noopener" target="_blank"
        >{frontmatter.domain}</a
      >
      {
        view.kind === "paired" && (
          <Fragment>
            <span aria-hidden="true">·</span>
            <span lang="zh-CN">{t.translatedDone}</span>
          </Fragment>
        )
      }
    </p>
  </article>
</Base>

<style>
  /* Raw tokens (--paper/--accent…), never --color-*: `@theme inline`
     substitutes those away at build time. */
  .reader {
    --size: var(--reader-size, 19px);
  }

  /* Chrome, so it spans the viewport at a fixed gutter rather than following
     the text: it must not move when the reading mode changes the measure. */
  .toolbar {
    position: sticky;
    /* The site header is not sticky on an article, so this is the top. */
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding: 10px var(--gutter);
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    font-family: var(--font-ui);
    font-size: 13px;
  }
  .back {
    color: var(--ink-mute);
    text-decoration: none;
    white-space: nowrap;
  }
  .back:hover {
    color: var(--ink);
  }
  .divider {
    width: 1px;
    height: 18px;
    background: var(--rule);
  }
  /* The toolbar is left-packed; this group is the only thing that sits right.
     It wraps onto its own line on a narrow screen, where `auto` collapses. */
  .share {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  /* A phone's browser already carries a share control in its own chrome, and
     the source link is in the title block and the end-note besides — so on a
     small screen the page is repeating what is a tap away and paying a whole
     row of sticky toolbar for it. Hidden, the bar goes from two rows to one:
     90px to 51px, on the screens with the least room.
     What is genuinely lost is the short link, which is the one thing these
     buttons carry that the browser's share cannot: it sends whatever is in the
     address bar, which is the long URL. Accepted — on a phone you reach for
     the browser's share anyway.
     The breakpoint is measured rather than picked: 688px is where these
     controls stop wrapping. It tracks their combined width, so re-measure if
     a label changes. Hiding them at the `40rem` step instead would leave
     640-688px wrapping for no benefit.
     688 is the worst case, which is the one a media query has to take: where
     the browser has no share sheet the script hides 分享, and the rest fit from
     640px — but CSS cannot know that, and hiding slightly early is better than
     wrapping. */
  /* Exclusive: 688px is where they fit, so they must show there, not hide. */
  @media (width < 43rem) {
    .share {
      display: none;
    }
  }
  /* `.chip` is `display: inline-flex`, which beats the `hidden` attribute — the
     share button would show on every desktop without this. */
  .share .chip[hidden] {
    display: none;
  }
  .share .source {
    color: var(--ink-mute);
  }
  /* Between the width where the share controls appear and the width where the
     bar has room to spare, a long domain pushes them onto a second row — 28 of
     the vault's 102 articles have one over 17 characters, too many to call an
     edge case. Measured: uncapped, the longest in the vault wraps the bar up to
     780px and fits from 800px. So the cap applies only in that band; above it
     the domain is shown in full, and below it these controls are hidden
     anyway. The full value stays in `title` and `aria-label` regardless. */
  @media (width < 50rem) {
    .share .source-name {
      display: inline-block;
      max-width: 16ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      vertical-align: bottom;
    }
  }
  .share .source:hover {
    color: var(--ink);
  }
  /* One reading measure for everything below the toolbar: `--w-reader` for a
     single column (800px — about 78 Latin or 40 Chinese characters at the
     default size, and fixed), `--w-reader-wide` when two columns sit side by
     side (1240 by default, adjustable in Settings). The title block follows the
     switch along with the body — before, it stayed at the side-by-side width
     while the body narrowed.

     Every rule below that reads the mode does so as
     `:global(html[data-reader-mode="…"]) .reader[data-paired]`, and both halves
     are load-bearing. The mode is on <html> because it has to be applied before
     first paint (Base.astro) — which means it is set on every page, including
     articles that have no translation at all. `data-paired` is rendered only for
     a paired view, so it is what stops `原文` from hiding the only Chinese on a
     single-pane article, and `中文` from hiding the English title above an
     English body. Add the guard to any new rule even where it looks redundant. */
  .head {
    padding-top: 56px;
    padding-bottom: 8px;
  }
  /* Side by side: the original's title, meta and tags over the original pane,
     the Chinese title and summary over the translation pane. One column
     otherwise, and the summary follows the tags. */
  .titles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px 64px;
  }
  @media (min-width: 64rem) {
    :global(html[data-reader-mode="both"]) .reader[data-paired] .titles {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    /* The Chinese column has no meta row of its own — it was the original's
       line over again, differing only in how the reading time was phrased — so
       it is offset by that row's height instead. One rule for both cases: with
       a Chinese title it puts the title level with the h1, without one it puts
       the summary there. */
    :global(html[data-reader-mode="both"]) .reader[data-paired] .zh {
      padding-top: 32px;
    }
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
  }
  .meta a {
    color: inherit;
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .titles h1:not(.title-zh) {
    margin: 0;
    font-size: 38px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .title-zh {
    margin: 0;
    font-family: var(--font-zh);
    font-size: 34px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-wrap: pretty;
  }
  @media (max-width: 39.99rem) {
    .titles h1:not(.title-zh) {
      font-size: 30px;
    }
    .title-zh {
      font-size: 27px;
    }
  }
  /* Under both columns rather than inside the original's. The tags describe the
     article, not the language you are reading it in — and with the title block
     collapsing by mode, leaving them in the left column made 中文 read
     meta, tags, title, summary. */
  .terms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 24px 0 0;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-mute);
  }
  .terms a {
    color: inherit;
    text-decoration: none;
  }
  .terms a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .terms .pill {
    font-size: 11px;
  }
  .title-rule {
    margin: 36px 0 8px;
    border: 0;
    border-top: 1px solid var(--rule);
  }
  .lead {
    margin: 0;
    font-family: var(--font-zh);
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-soft);
  }
  .title-zh + .lead {
    margin-top: 14px;
  }
  /* The original's half of the pair: the same shape in the reading serif, since
     the Chinese face is for Chinese. It sits directly under the h1, where its
     counterpart sits under the Chinese title, so the two start level; the tags
     move below it, which changes nothing for an article that has no
     summary_orig. Same 摘要 label on both — the meta row above already repeats
     itself across the columns rather than labelling one of them. */
  .lead-orig {
    margin-top: 14px;
    font-family: inherit;
  }
  /* A label, not the summary's first word — which is how it read while it
     inherited the lead's serif at the lead's size and differed only in colour.
     --font-ui is the token for exactly this ("chrome — nav, controls, meta rows,
     footer, help text… content stays --font-serif" in global.css), and it also
     sidesteps the case that comment warns about: 摘要 at this size in the
     reading serif falls back to a hairline Songti. */
  .lead-label {
    margin-right: 0.6em;
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
  }

  #reader,
  .reader-single {
    padding-top: 16px;
    padding-bottom: 64px;
  }
  .notice {
    margin: 8px 0 24px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-mute);
  }
  /* The colour lives here, not on a `text-*` utility: Astro scopes this rule
     as `.notice[data-astro-cid-…]`, so any single-class utility loses to it. */
  .notice--warn {
    color: var(--warn);
  }

  /* One grid row per block keeps the two panes aligned while scrolling. The
     `minmax(0, 1fr)` tracks are load-bearing — see the overflow comment in
     global.css. */
  .reader-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px 64px;
    padding: 14px 16px;
    margin: 0 -16px;
    border-radius: 8px;
    transition: background 0.15s;
  }
  @media (min-width: 64rem) {
    :global(html[data-reader-mode="both"]) .reader[data-paired] .reader-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    :global(html[data-reader-mode="both"])
      .reader[data-paired]
      .reader-row:hover {
      background: var(--wash);
    }
  }
  :global(html[data-reader-mode="original"])
    .reader[data-paired]
    .pane-translation,
  :global(html[data-reader-mode="translation"])
    .reader[data-paired]
    .pane-original {
    display: none;
  }
  /* The head follows the panes: one language at a time means one title and one
     summary, not both sitting over a single column of text. The meta row and the
     tags stay in either mode — they are the article's, not one version's — which
     is why the original's title and summary are hidden one by one instead of by
     hiding the column that also holds them.

     This is why the Chinese title is an h1 as well. The page had exactly one,
     the original, and hiding it would leave 中文 with no h1 at all; now each
     single-language mode has exactly one and side by side has two, which is what
     a document with two titles is.

     And it is why the 中文 rule also asks for `data-zh-title`. title_zh is
     optional by design, so a fully translated article can have no Chinese title
     — the model omitted it, it was rejected as an echo, or the article was
     processed before the field existed, which is every article in a vault whose
     backfill has not run. Hiding the original title there would leave the page
     with no title at all. The original half only steps aside when the other
     half can stand in its place. */
  :global(html[data-reader-mode="translation"])
    .reader[data-paired][data-zh-title]
    .orig
    :is(h1, .lead-orig),
  :global(html[data-reader-mode="original"]) .reader[data-paired] .zh {
    display: none;
  }

  /* Body type. The original reads light (Spectral 300) at the chosen size;
     the translation one px smaller, on its own leading from global.css. */
  .pane-original,
  .reader-single .prose:not([lang="zh-CN"], [lang="zh"]) {
    font-size: var(--size);
    line-height: 1.62;
    font-weight: 300;
    text-wrap: pretty;
  }
  .pane-translation,
  .reader-single .prose:is([lang="zh-CN"], [lang="zh"]) {
    font-size: calc(var(--size) - 1px);
    text-wrap: pretty;
  }

  /* Per-block prose roots suppress prose's own heading margins — every block is
     both :first-child and :last-child of its pane, so typography zeroes them —
     and the row padding then spaces every row identically. Give rows that open
     a section their breathing room back, graded by level so the hierarchy
     reads. All six levels: clipped papers use h1 for the title and h4-h6 for
     abstracts, theorems and proofs. */
  #reader > :global(.reader-row:has(h1, h2):not(:first-child)) {
    margin-top: 2.5rem;
  }
  #reader > :global(.reader-row:has(h3):not(:first-child)) {
    margin-top: 1.5rem;
  }
  #reader > :global(.reader-row:has(h4, h5, h6):not(:first-child)) {
    margin-top: 1rem;
  }

  .end-note {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 8px;
    padding-bottom: 96px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-mute);
  }
  .end-note a {
    color: inherit;
  }
  .end-note a:hover {
    color: var(--accent);
  }
</style>

<script is:inline>
  {
    // The toolbar only moves the preference; the mode itself is written onto
    // <html> before first paint, by the same script that handles paper and
    // width. Applying it here instead moved text the reader was already
    // looking at, every time an article loaded. What is left is the three lines
    // every other control on the site has — read, write, re-sync on the event.
    //
    // The null guard stays: unlike the library's toggle, this one renders only
    // for an article that actually has a translation.
    const toggle = document.getElementById("view-toggle");
    if (toggle !== null) {
      const buttons = toggle.querySelectorAll("button");
      const sync = () => {
        const mode = window.tiroPrefs.readerMode();
        for (const b of buttons)
          b.setAttribute("aria-pressed", String(b.dataset.view === mode));
      };
      for (const b of buttons)
        b.addEventListener("click", () =>
          window.tiroPrefs.setReaderMode(b.dataset.view),
        );
      document.addEventListener("tiro:prefs", sync);
      sync();
    }
  }
</script>

<script is:inline>
  {
    // Share controls. Progressive enhancement in both directions: 分享 is
    // rendered hidden and only revealed where a share sheet exists (most
    // desktop browsers have none, and a button that does nothing is worse than
    // no button), and 复制链接 falls back to a throwaway <textarea> where the
    // async clipboard is unavailable.
    const group = document.querySelector(".share:not([data-bound])");
    if (group !== null) {
      group.dataset.bound = "";
      const url = group.dataset.shareUrl;
      const title = group.dataset.shareTitle;

      const copyBtn = group.querySelector("[data-copy]");
      let restore;
      const flash = (text) => {
        copyBtn.textContent = text;
        clearTimeout(restore);
        restore = setTimeout(() => {
          copyBtn.textContent = copyBtn.dataset.idle;
        }, 1500);
      };
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
          flash(copyBtn.dataset.done);
          return;
        } catch {
          // Falls through: no async clipboard, or permission refused.
        }
        const area = document.createElement("textarea");
        area.value = url;
        area.setAttribute("readonly", "");
        // Off-screen rather than hidden: a display:none field cannot be
        // selected, and scrolling the page would move what the reader is
        // looking at.
        area.style.cssText = "position:fixed;top:-9999px;opacity:0";
        document.body.append(area);
        area.select();
        let copied = false;
        try {
          copied = document.execCommand("copy");
        } catch {
          copied = false;
        }
        area.remove();
        flash(copied ? copyBtn.dataset.done : copyBtn.dataset.failed);
      });

      const shareBtn = group.querySelector("[data-share]");
      if (typeof navigator.share === "function") {
        shareBtn.hidden = false;
        shareBtn.addEventListener("click", async () => {
          try {
            await navigator.share({ title, url });
          } catch {
            // Dismissing the sheet rejects. That is the reader deciding not to
            // share, not a failure to report back to them.
          }
        });
      }
    }
  }
</script>
