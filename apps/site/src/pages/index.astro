---
import Library from "../components/Library.astro";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles.ts";
import { pageCount, slicePage } from "../lib/pager.ts";
import { STRINGS } from "../lib/strings.ts";

// Page 1 of the library; pages 2..N live in page/[page].astro.
const articles = await getArticles();
---

<Base>
  <Library
    articles={slicePage(articles, 1)}
    heading={STRINGS.library.title}
    pager={{
      current: 1,
      last: pageCount(articles.length),
      total: articles.length,
    }}
  />
</Base>
