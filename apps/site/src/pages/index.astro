---
import ArticleCard from "../components/ArticleCard.astro";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles.ts";
import { monthLabel, STRINGS } from "../lib/strings.ts";

const articles = await getArticles();
const byMonth = new Map<string, typeof articles>();
for (const article of articles) {
  const month = article.frontmatter.clipped_at.slice(0, 7);
  const list = byMonth.get(month) ?? [];
  list.push(article);
  byMonth.set(month, list);
}
---

<Base>
  {articles.length === 0 && <p class="text-ink-soft">{STRINGS.list.empty}</p>}
  {
    [...byMonth.entries()].map(([month, list]) => (
      <section class="mb-12">
        <h2 class="mb-5 font-serif text-base font-medium text-ink-soft">
          {monthLabel(month)}
        </h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </section>
    ))
  }
</Base>
