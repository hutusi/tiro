---
import ArticleCard from "../components/ArticleCard.astro";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles.ts";
import { STRINGS } from "../lib/strings.ts";

const articles = await getArticles();
const byMonth = new Map<string, typeof articles>();
for (const article of articles) {
  const month = article.frontmatter.clipped_at.slice(0, 7);
  const list = byMonth.get(month) ?? [];
  list.push(article);
  byMonth.set(month, list);
}
---

<Base>
  {
    articles.length === 0 && (
      <p class="text-neutral-500">{STRINGS.list.empty}</p>
    )
  }
  {
    [...byMonth.entries()].map(([month, list]) => (
      <section class="mb-10">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-neutral-500">
          {month}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </section>
    ))
  }
</Base>
