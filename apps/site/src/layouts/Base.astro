---
import "../styles/global.css";
import { STRINGS } from "../lib/strings.ts";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
}
const { title, description, ogType = "website" } = Astro.props;
const pageTitle =
  title === undefined ? STRINGS.siteTitle : `${title} · ${STRINGS.siteTitle}`;
const rawDescription = description ?? STRINGS.siteDescription;
// Long article summaries overflow social cards; ~200 chars is plenty.
const metaDescription =
  rawDescription.length > 200
    ? `${rawDescription.slice(0, 197)}…`
    : rawDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const nav = [
  { href: "/", label: STRINGS.nav.home },
  { href: "/categories/", label: STRINGS.nav.categories },
  { href: "/tags/", label: STRINGS.nav.tags },
  { href: "/search/", label: STRINGS.nav.search },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={STRINGS.siteTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={STRINGS.siteTitle}
      href="/rss.xml"
    />
    <script is:inline>
      const stored = localStorage.getItem("theme");
      if (
        stored === "dark" ||
        (stored === null && matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100"
  >
    <header class="border-b border-neutral-200 dark:border-neutral-800">
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4"
      >
        <a
          href="/"
          class="inline-flex items-center gap-2 text-lg font-bold tracking-tight"
        >
          <svg class="h-6 w-6" viewBox="0 0 128 128" aria-hidden="true">
            <rect width="128" height="128" rx="28" fill="#1f883d"></rect>
            <path
              fill="#ffffff"
              d="M46 30 H82 a6 6 0 0 1 6 6 V98 a3 3 0 0 1 -4.8 2.4 L64 86 L44.8 100.4 A3 3 0 0 1 40 98 V36 a6 6 0 0 1 6 -6 Z"
            ></path>
          </svg>
          {STRINGS.siteTitle}
          <span class="text-sm font-normal text-neutral-500"
            >{STRINGS.siteTagline}</span
          >
        </a>
        <nav class="flex items-center gap-4 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
              >
                {item.label}
              </a>
            ))
          }
          <button
            id="theme-toggle"
            type="button"
            aria-label="切换深色模式"
            class="rounded-md border border-neutral-300 px-2 py-1 text-neutral-600 dark:border-neutral-700 dark:text-neutral-300"
          >
            <span class="dark:hidden">🌙</span><span class="hidden dark:inline"
              >☀️</span
            >
          </button>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-neutral-200 dark:border-neutral-800">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-neutral-500"
      >
        <p class="flex flex-wrap items-center gap-x-2">
          <span>{STRINGS.siteTitle} · {STRINGS.siteTagline}</span>
          <span>·</span>
          <span
            ><a href="https://hutusi.com" class="hover:underline">hutusi</a> 出品</span
          >
          <span>·</span>
          <span
            ><a href="https://ainaive.com" class="hover:underline">AI Naive</a> 系列项目</span
          >
        </p>
        <nav class="flex items-center gap-4">
          <a href="https://github.com/hutusi/tiro" class="hover:underline"
            >GitHub</a
          >
          <a href="/privacy/" class="hover:underline"
            >{STRINGS.footer.privacy}</a
          >
          <a href="/rss.xml" class="hover:underline">{STRINGS.footer.rss}</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", dark ? "dark" : "light");
      });
    </script>
  </body>
</html>
