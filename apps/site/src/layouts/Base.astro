---
import "@fontsource/spectral/latin-300.css";
import "@fontsource/spectral/latin-400.css";
import "@fontsource/spectral/latin-400-italic.css";
import "@fontsource/spectral/latin-500.css";
import "@fontsource/spectral/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/global.css";
import { PREF_SCRIPT_VARS } from "../lib/prefs.ts";
import { STRINGS } from "../lib/strings.ts";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  /** `library` (880px) for lists, `narrow` (680px) for settings-like pages,
   * `full` for the reader, which lays out its own columns. */
  width?: "library" | "narrow" | "full";
}
const {
  title,
  description,
  ogType = "website",
  width = "library",
} = Astro.props;
const pageTitle =
  title === undefined ? STRINGS.siteTitle : `${title} · ${STRINGS.siteTitle}`;
const rawDescription = description ?? STRINGS.siteDescription;
// Long article summaries overflow social cards; ~200 chars is plenty.
const metaDescription =
  rawDescription.length > 200
    ? `${rawDescription.slice(0, 197)}…`
    : rawDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const path = Astro.url.pathname;
const nav = [
  {
    href: "/",
    label: STRINGS.nav.home,
    active: path === "/" || path.startsWith("/page/"),
  },
  {
    href: "/search/",
    label: STRINGS.nav.search,
    active: /^\/(search|tags|categories)\//.test(path),
  },
  {
    href: "/settings/",
    label: STRINGS.nav.settings,
    active: path.startsWith("/settings/"),
  },
];
const mainClass =
  width === "narrow"
    ? "mx-auto w-full max-w-[680px] px-4 pt-12 pb-16 sm:px-6 lg:px-10"
    : "mx-auto w-full max-w-[880px] px-4 pt-12 pb-16 sm:px-6 lg:px-10";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={STRINGS.siteTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={STRINGS.siteTitle}
      href="/rss.xml"
    />
    <script define:vars={{ P: PREF_SCRIPT_VARS }}>
      // Runs before first paint: puts the stored paper, reader text size and
      // library view on <html>, then exposes `tiroPrefs` for the controls that
      // change them. Inline on purpose — a bundled module is deferred and
      // would flash the default paper. Keys and ranges come from
      // src/lib/prefs.ts through `P`; the clamp below mirrors clampFontSize.
      const root = document.documentElement;
      const read = (key) => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };
      const write = (key, value) => {
        try {
          localStorage.setItem(key, value);
        } catch {}
      };
      const remove = (key) => {
        try {
          localStorage.removeItem(key);
        } catch {}
      };
      const clamp = (value) => {
        const n = Number.parseFloat(value);
        if (!Number.isFinite(n)) return P.FONT_SIZE.default;
        return Math.min(
          P.FONT_SIZE.max,
          Math.max(P.FONT_SIZE.min, Math.round(n)),
        );
      };
      const changed = (key, value) =>
        document.dispatchEvent(
          new CustomEvent("tiro:prefs", { detail: { key, value } }),
        );

      let paper = read(P.PREF_KEYS.paper);
      if (paper === null) {
        // One-time migration from the pre-redesign light/dark toggle. Both
        // values were explicit choices: a reader who picked light on a
        // dark-mode machine must not wake up on dark paper.
        const legacy = read(P.PREF_KEYS.legacyTheme);
        if (legacy === "dark" || legacy === "light") {
          paper = legacy === "dark" ? "dark" : "cream";
          write(P.PREF_KEYS.paper, paper);
        }
        if (legacy !== null) remove(P.PREF_KEYS.legacyTheme);
      }
      if (!P.PAPERS.includes(paper)) {
        paper = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "cream";
      }
      root.dataset.paper = paper;

      let fontSize = clamp(read(P.PREF_KEYS.fontSize));
      root.style.setProperty("--reader-size", `${fontSize}px`);

      let libraryView = read(P.PREF_KEYS.libraryView);
      if (!P.LIBRARY_VIEWS.includes(libraryView)) libraryView = "list";
      root.dataset.libraryView = libraryView;

      window.tiroPrefs = {
        paper: () => root.dataset.paper,
        setPaper(value) {
          if (!P.PAPERS.includes(value)) return;
          root.dataset.paper = value;
          write(P.PREF_KEYS.paper, value);
          changed("paper", value);
        },
        fontSize: () => fontSize,
        fontSizeRange: () => P.FONT_SIZE,
        setFontSize(value) {
          fontSize = clamp(value);
          root.style.setProperty("--reader-size", `${fontSize}px`);
          write(P.PREF_KEYS.fontSize, String(fontSize));
          changed("fontSize", fontSize);
          return fontSize;
        },
        libraryView: () => root.dataset.libraryView,
        setLibraryView(value) {
          if (!P.LIBRARY_VIEWS.includes(value)) return;
          root.dataset.libraryView = value;
          write(P.PREF_KEYS.libraryView, value);
          changed("libraryView", value);
        },
        readerMode() {
          const mode = read(P.PREF_KEYS.readerMode);
          return P.READER_MODES.includes(mode) ? mode : "both";
        },
        setReaderMode(value) {
          if (!P.READER_MODES.includes(value)) return;
          write(P.PREF_KEYS.readerMode, value);
          changed("readerMode", value);
        },
      };
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <header class="sticky top-0 z-20 border-b border-rule bg-paper">
      <div class="flex h-14 items-center gap-4 px-4 sm:gap-7 sm:px-6 lg:px-10">
        <a href="/" class="inline-flex items-center gap-2 text-ink">
          <span class="logo-bars" aria-hidden="true"><i></i><i></i></span>
          <span class="text-[21px] font-semibold tracking-[-0.01em]"
            >{STRINGS.siteTitle}</span
          >
        </a>
        <nav aria-label="主导航" class="flex items-center gap-1 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class:list={[
                  "rounded-md px-2.5 py-1.5 transition-colors sm:px-3",
                  item.active
                    ? "bg-chip text-ink"
                    : "text-ink-soft hover:bg-wash hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    {
      width === "full" ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class:list={["flex-1", mainClass]}>
          <slot />
        </main>
      )
    }
    <footer
      class="mx-auto flex w-full max-w-[880px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 pb-8 text-xs text-ink-mute sm:px-6 lg:px-10"
    >
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="logo-bars logo-bars--mini" aria-hidden="true"
          ><i></i><i></i></span
        >
        <span>{STRINGS.siteTitle} · {STRINGS.siteTagline}</span>
        <span aria-hidden="true">·</span>
        <span
          ><a href="https://hutusi.com" class="hover:text-ink">hutusi</a> 出品</span
        >
        <span aria-hidden="true">·</span>
        <span
          ><a href="https://ainaive.com" class="hover:text-ink">AI Naive</a> 系列项目</span
        >
      </p>
      <nav
        aria-label="页脚导航"
        class="flex items-center gap-4 whitespace-nowrap"
      >
        <a href="https://github.com/hutusi/tiro" class="hover:text-ink"
          >GitHub</a
        >
        <a href="/privacy/" class="hover:text-ink">{STRINGS.footer.privacy}</a>
        <a href="/rss.xml" class="hover:text-ink">{STRINGS.footer.rss}</a>
      </nav>
    </footer>
  </body>
</html>
