---
import "@fontsource/spectral/latin-300.css";
import "@fontsource/spectral/latin-400.css";
import "@fontsource/spectral/latin-400-italic.css";
import "@fontsource/spectral/latin-500.css";
import "@fontsource/spectral/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/global.css";
import { STRINGS } from "../lib/strings.ts";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
}
const { title, description, ogType = "website" } = Astro.props;
const pageTitle =
  title === undefined ? STRINGS.siteTitle : `${title} · ${STRINGS.siteTitle}`;
const rawDescription = description ?? STRINGS.siteDescription;
// Long article summaries overflow social cards; ~200 chars is plenty.
const metaDescription =
  rawDescription.length > 200
    ? `${rawDescription.slice(0, 197)}…`
    : rawDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const nav = [
  { href: "/", label: STRINGS.nav.home },
  { href: "/categories/", label: STRINGS.nav.categories },
  { href: "/tags/", label: STRINGS.nav.tags },
  { href: "/search/", label: STRINGS.nav.search },
];
const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={STRINGS.siteTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={STRINGS.siteTitle}
      href="/rss.xml"
    />
    <script is:inline>
      const stored = localStorage.getItem("theme");
      if (
        stored === "dark" ||
        (stored === null && matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.dataset.paper = "dark";
      }
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <header class="border-b border-rule">
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5"
      >
        <a href="/" class="inline-flex items-center gap-2 tracking-tight">
          <svg class="h-6 w-6" viewBox="0 0 128 128" aria-hidden="true">
            <rect width="128" height="128" rx="28" class="fill-accent"></rect>
            <path
              fill="#ffffff"
              d="M46 30 H82 a6 6 0 0 1 6 6 V98 a3 3 0 0 1 -4.8 2.4 L64 86 L44.8 100.4 A3 3 0 0 1 40 98 V36 a6 6 0 0 1 6 -6 Z"
            ></path>
          </svg>
          <span class="font-serif text-xl font-semibold"
            >{STRINGS.siteTitle}</span
          >
          <span class="hidden text-sm font-normal text-ink-soft sm:inline"
            >{STRINGS.siteTagline}</span
          >
        </a>
        <nav aria-label="主导航" class="flex items-center gap-4 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class={
                  isActive(item.href)
                    ? "font-medium text-accent"
                    : "text-ink-soft hover:text-ink"
                }
              >
                {item.label}
              </a>
            ))
          }
          <button
            id="theme-toggle"
            type="button"
            aria-label="切换深色模式"
            class="rounded-md border border-rule px-2 py-1.5 text-ink-soft transition-colors hover:border-rule hover:text-ink"
          >
            <svg
              class="h-4 w-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
            </svg>
            <svg
              class="hidden h-4 w-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-rule">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-ink-soft"
      >
        <p class="flex flex-wrap items-center gap-x-2">
          <span>{STRINGS.siteTitle} · {STRINGS.siteTagline}</span>
          <span>·</span>
          <span
            ><a
              href="https://hutusi.com"
              class="hover:text-accent hover:underline">hutusi</a
            > 出品</span
          >
          <span>·</span>
          <span
            ><a
              href="https://ainaive.com"
              class="hover:text-accent hover:underline">AI Naive</a
            > 系列项目</span
          >
        </p>
        <nav aria-label="页脚导航" class="flex items-center gap-4">
          <a
            href="https://github.com/hutusi/tiro"
            class="hover:text-accent hover:underline">GitHub</a
          >
          <a href="/privacy/" class="hover:text-accent hover:underline"
            >{STRINGS.footer.privacy}</a
          >
          <a href="/rss.xml" class="hover:text-accent hover:underline"
            >{STRINGS.footer.rss}</a
          >
        </nav>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.paper !== "dark";
        if (dark) root.dataset.paper = "dark";
        else delete root.dataset.paper;
        localStorage.setItem("theme", dark ? "dark" : "light");
      });
    </script>
  </body>
</html>
