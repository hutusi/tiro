---
/**
 * The article list: heading, list/cards switch, items, optional pager. One
 * DOM for both views — `html[data-library-view]` (set by the pre-paint
 * script) picks the presentation, so switching never re-renders anything.
 */
import type { Article } from "../lib/articles.ts";
import { pageNote, STRINGS } from "../lib/strings.ts";
import ArticleItem from "./ArticleItem.astro";
import Pager from "./Pager.astro";

interface Props {
  articles: Article[];
  heading: string;
  /** Shown beside the heading on filtered lists (a tag, a category). */
  count?: number;
  pager?: { current: number; last: number; total: number };
}
const { articles, heading, count, pager } = Astro.props;
const t = STRINGS.library;
---

<div class="mb-7 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
  <h1 class="text-[34px] font-medium tracking-[-0.01em]">
    {heading}
    {
      count !== undefined && (
        <span class="ml-2 font-mono text-base font-normal text-ink-mute">
          {count}
        </span>
      )
    }
  </h1>
  <div
    id="view-toggle"
    class="segmented mb-1"
    role="group"
    aria-label={t.viewLabel}
  >
    <button type="button" data-value="list" aria-pressed="false"
      >{t.viewList}</button
    >
    <button type="button" data-value="cards" aria-pressed="false"
      >{t.viewCards}</button
    >
  </div>
</div>

{articles.length === 0 && <p class="text-ink-soft">{STRINGS.list.empty}</p>}

<ol class="items m-0 list-none p-0">
  {articles.map((article) => <ArticleItem article={article} />)}
</ol>

{
  pager !== undefined && pager.last > 1 && (
    <Fragment>
      <Pager {...pager} />
      <p class="mt-3 text-center text-xs text-ink-mute">
        {pageNote(pager.current, pager.last, pager.total)}
      </p>
    </Fragment>
  )
}

<style>
  :global(html[data-library-view="cards"]) .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
</style>

<script is:inline>
  {
    const toggle = document.getElementById("view-toggle");
    const buttons = toggle.querySelectorAll("button");
    const sync = () => {
      const view = window.tiroPrefs.libraryView();
      for (const b of buttons)
        b.setAttribute("aria-pressed", String(b.dataset.value === view));
    };
    for (const b of buttons)
      b.addEventListener("click", () =>
        window.tiroPrefs.setLibraryView(b.dataset.value),
      );
    document.addEventListener("tiro:prefs", sync);
    sync();
  }
</script>
