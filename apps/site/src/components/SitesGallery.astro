---
/**
 * The saved-sites gallery (ADR 0055): a grid of picture cards, newest first,
 * paged like the library. One component for `/sites/` and `/sites/page/N/`,
 * so the two cannot drift.
 *
 * Never a Pagefind body, not even its empty state: each site's own page is
 * what the index holds, and the library's empty state is the one place that
 * may declare a body for the narrowing rule to hold (see `Library.astro`).
 */
import { pageCount } from "../lib/pager.ts";
import { type Site, sitesPageUrl } from "../lib/sites.ts";
import { sitesPageNote, STRINGS } from "../lib/strings.ts";
import Pager from "./Pager.astro";
import SiteCard from "./SiteCard.astro";

interface Props {
  sites: Site[];
  current: number;
  total: number;
}
const { sites, current, total } = Astro.props;
const last = pageCount(total);
const t = STRINGS.sites;
---

<div class="mb-7">
  <h1 class="text-[34px] font-medium tracking-[-0.01em]">
    {t.title}
    {
      total > 0 && (
        <span class="ml-2 font-mono text-base font-normal text-ink-mute">
          {total}
        </span>
      )
    }
  </h1>
  <p class="mt-2 font-ui text-sm text-ink-mute">{t.tagline}</p>
</div>

{total === 0 && <p class="text-ink-soft">{t.empty}</p>}

<ul class="gallery m-0 list-none p-0">
  {sites.map((site, i) => <SiteCard site={site} eager={i < 4} />)}
</ul>

{
  last > 1 && (
    <Fragment>
      <Pager current={current} last={last} total={total} href={sitesPageUrl} />
      <p class="mt-3 text-center font-ui text-xs text-ink-mute">
        {sitesPageNote(current, last, total)}
      </p>
    </Fragment>
  )
}

<style>
  /* The collections gallery's grid, so the two galleries line up. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
</style>
