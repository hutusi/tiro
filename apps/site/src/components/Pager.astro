---
import { pageUrl, pageWindow } from "../lib/pager.ts";
import { STRINGS } from "../lib/strings.ts";

interface Props {
  current: number;
  last: number;
  total: number;
  /** A page's address; the library's by default. The saved-sites gallery
   * pages the same way under its own path (ADR 0055). */
  href?: (page: number) => string;
}
const { current, last, href = pageUrl } = Astro.props;
const t = STRINGS.library;
const items = pageWindow(current, last);
const cell =
  "inline-flex h-[30px] min-w-[30px] items-center justify-center rounded-md px-2";
---

<nav
  aria-label={t.pagerLabel}
  class="mt-10 flex flex-wrap items-center justify-center gap-4 font-ui text-[13px]"
>
  {
    current > 1 ? (
      <a href={href(current - 1)} class="text-ink-soft hover:text-ink">
        {t.newer}
      </a>
    ) : (
      <span aria-disabled="true" class="text-ink-mute">
        {t.newer}
      </span>
    )
  }
  <div class="flex items-center gap-1 font-mono text-xs">
    {
      items.map((item) =>
        item === "…" ? (
          <span class:list={[cell, "text-ink-mute"]}>…</span>
        ) : item === current ? (
          <span
            aria-current="page"
            class:list={[
              cell,
              "border border-accent-fill bg-accent-fill text-white",
            ]}
          >
            {item}
          </span>
        ) : (
          <a
            href={href(item)}
            class:list={[
              cell,
              "border border-transparent text-ink-soft hover:border-rule hover:text-ink",
            ]}
          >
            {item}
          </a>
        ),
      )
    }
  </div>
  {
    current < last ? (
      <a href={href(current + 1)} class="text-ink-soft hover:text-ink">
        {t.older}
      </a>
    ) : (
      <span aria-disabled="true" class="text-ink-mute">
        {t.older}
      </span>
    )
  }
</nav>
