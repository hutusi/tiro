---
/**
 * One saved site in the gallery (ADR 0055): its screenshot, then its title,
 * the introduction and a meta line — the collection card's family, so the
 * two galleries read as one. The card opens the site's page; a small corner
 * link opens the site itself, which is what most visits to a tool are for.
 *
 * The screenshot goes through `CollectionCover`, so a site saved without one
 * gets the same typographic cover a collection without pictures does.
 */
import { siteHref, previewSrc, type Site, siteUrl } from "../lib/sites.ts";
import { dateLabel, STRINGS } from "../lib/strings.ts";
import CollectionCover from "./CollectionCover.astro";

interface Props {
  site: Site;
  /** The first row of a gallery page: loaded with the page. */
  eager?: boolean;
}
const { site, eager = false } = Astro.props;
const { frontmatter: fm } = site;
const t = STRINGS.sites;
const preview = previewSrc(site);
const href = siteHref(site);
const intro = fm.summary ?? fm.description;
---

<li class="card">
  <a href={siteUrl(site)} class="card-link">
    <div class="art">
      <CollectionCover
        images={preview === null ? [] : [preview]}
        title={fm.title}
        eager={eager}
      />
    </div>
    <div class="text">
      <h2 class="title">{fm.title}</h2>
      {
        fm.title_zh !== undefined && (
          <p class="title-zh" lang="zh-CN">
            {fm.title_zh}
          </p>
        )
      }
      {intro !== undefined && <p class="desc">{intro}</p>}
      <p class="meta">
        <span class="domain">{fm.domain}</span>
        <time datetime={fm.clipped_at}>{dateLabel(fm.clipped_at)}</time>
      </p>
    </div>
  </a>
  {
    href !== null && (
      <a
        class="open"
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${t.open}：${fm.title}`}
        title={t.open}
      >
        ↗
      </a>
    )
  }
</li>

<style>
  /* Raw tokens (--rule, --accent…), never --color-*: `@theme inline`
     substitutes those away at build time. */
  .card {
    position: relative;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--field);
    overflow: hidden;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--ink-mute);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 10px;
  }
  .art {
    /* A page is read from the top: a crop that kept the middle would cut
       off the header that says what the site is. */
    --cover-position: top;
    border-bottom: 1px solid var(--rule);
  }
  .card:hover .art :global(img) {
    transform: scale(1.02);
  }
  .text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 14px 18px 14px;
  }
  .title {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .card:hover .title {
    color: var(--accent);
  }
  .title-zh {
    margin: 0;
    font-family: var(--font-zh);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .desc {
    margin: 2px 0 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: auto 0 0;
    padding-top: 6px;
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--ink-mute);
  }
  .meta .domain {
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }
  .meta time::before {
    content: "· ";
  }
  .open {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--field);
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-soft);
    text-decoration: none;
    opacity: 0.92;
  }
  .open:hover,
  .open:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover .art :global(img) {
      transition: none;
      transform: none;
    }
  }
</style>
