---
import {
  type Article,
  articleUrl,
  categoryUrl,
  tagUrl,
} from "../lib/articles.ts";

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { frontmatter } = article;
const date = frontmatter.clipped_at.slice(0, 10);
---

<article
  class="group relative flex h-full flex-col rounded-xl border border-rule bg-field p-5 shadow-xs transition hover:border-rule hover:shadow-md"
>
  <a href={articleUrl(article)} class="block">
    <h2
      class="font-serif text-lg font-semibold leading-snug transition-colors group-hover:text-accent"
    >
      {frontmatter.title}
    </h2>
    {
      frontmatter.summary !== undefined && (
        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-soft">
          {frontmatter.summary}
        </p>
      )
    }
  </a>
  <div
    class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-4 text-xs text-ink-soft"
  >
    <span>{frontmatter.domain}</span>
    <span class="text-ink-mute">·</span>
    <time datetime={frontmatter.clipped_at}>{date}</time>
    {
      frontmatter.category !== undefined && (
        <a
          href={categoryUrl(frontmatter.category)}
          class="rounded-full bg-chip px-2 py-0.5 text-accent transition-colors hover:bg-accent hover:text-field"
        >
          {frontmatter.category}
        </a>
      )
    }
    {
      (frontmatter.tags ?? []).map((tag) => (
        <a
          href={tagUrl(tag)}
          class="text-ink-soft hover:text-accent hover:underline focus-visible:underline"
        >
          #{tag}
        </a>
      ))
    }
  </div>
</article>
