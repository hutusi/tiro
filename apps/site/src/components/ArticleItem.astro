---
/**
 * One article in the library — a list row by default, a card under
 * `html[data-library-view="cards"]`. The whole item opens the article (a
 * stretched pseudo-element on the title link); tag and category links sit
 * above it so they stay clickable on their own.
 *
 * Or one saved site (ADR 0055), where a tag, a category or a collection lists
 * one beside articles: the same row, badged 网站, with its screenshot in place
 * of a reading time — one component, so the two kinds of row cannot drift.
 */
import { articleMeta } from "../lib/article-meta.ts";
import {
  type Article,
  articleUrl,
  categoryUrl,
  tagUrl,
} from "../lib/articles.ts";
import { servedCopy } from "../lib/asset-manifest.ts";
import { previewSrc, type Site, siteUrl } from "../lib/sites.ts";
import { dateLabel, minutesLabel, STRINGS } from "../lib/strings.ts";

type Props = {
  /** 3 under a collection's section heading, so the outline nests (ADR 0051). */
  headingLevel?: 2 | 3;
} & ({ article: Article; site?: never } | { site: Site; article?: never });
const { article, site, headingLevel = 2 } = Astro.props;
const Title = headingLevel === 3 ? "h3" : "h2";

interface Row {
  href: string;
  fm: {
    domain: string;
    title: string;
    clipped_at: string;
    category?: string | undefined;
    tags?: string[] | undefined;
  };
  titleZh: string | null;
  summary: string | undefined;
  pill: string | null;
  minutes: string | null;
  thumb: string | null;
}
let row: Row;
if (article !== undefined) {
  const meta = articleMeta(article);
  row = {
    href: articleUrl(article),
    fm: article.frontmatter,
    titleZh: meta.titleZh,
    summary: article.frontmatter.summary,
    pill: {
      pending: STRINGS.status.pending,
      "zh-original": STRINGS.status.zhOriginal,
      untranslated: STRINGS.status.untranslated,
      translated: null,
    }[meta.status],
    minutes: minutesLabel(meta.minutes),
    thumb: null,
  };
} else {
  const preview = previewSrc(site);
  row = {
    href: siteUrl(site),
    fm: site.frontmatter,
    titleZh: site.frontmatter.title_zh ?? null,
    // The introduction once the processor has written one, and until then
    // the page's own description.
    summary: site.frontmatter.summary ?? site.frontmatter.description,
    pill: STRINGS.sites.badge,
    minutes: null,
    thumb: preview === null ? null : (servedCopy(preview)?.src ?? preview),
  };
}
const { fm } = row;
const statusLabel = row.pill;
---

<li
  class:list={[
    "item",
    { "is-site": site !== undefined, "has-thumb": row.thumb !== null },
  ]}
>
  {
    row.thumb !== null && (
      <img
        class="thumb"
        src={row.thumb}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
  <a href={row.href} class="item-link">
    <div class="top">
      <span class="domain">{fm.domain}</span>
      {statusLabel !== null && <span class="pill">{statusLabel}</span>}
    </div>
    <Title class="title">{fm.title}</Title>
    {
      row.titleZh !== null && (
        <p class="title-zh" lang="zh-CN">
          {row.titleZh}
        </p>
      )
    }
    {row.summary !== undefined && <p class="summary">{row.summary}</p>}
  </a>
  <div class="meta">
    <span class="domain">{fm.domain}</span>
    {row.minutes !== null && <span class="minutes">{row.minutes}</span>}
    <time datetime={fm.clipped_at}>{dateLabel(fm.clipped_at)}</time>
    {statusLabel !== null && <span class="pill">{statusLabel}</span>}
    {
      fm.category !== undefined && (
        <a class="term" href={categoryUrl(fm.category)}>
          {fm.category}
        </a>
      )
    }
    {
      (fm.tags ?? []).map((tag) => (
        <a class="term" href={tagUrl(tag)}>
          #{tag}
        </a>
      ))
    }
  </div>
</li>

<style>
  /* Raw tokens (--rule, --accent…), never --color-*: `@theme inline`
     substitutes those away at build time. */
  .item {
    position: relative;
    padding: 26px 20px;
    margin: 0 -20px;
    border-radius: 8px;
    border-bottom: 1px solid var(--rule);
    transition:
      background 0.15s,
      box-shadow 0.15s;
  }
  .item:hover {
    background: var(--wash);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .item-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .item-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .top {
    display: none;
  }
  .title {
    margin: 0 0 5px;
    font-size: 23px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.008em;
    text-wrap: pretty;
  }
  .title-zh {
    margin: 0 0 12px;
    font-family: var(--font-zh);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .summary {
    margin: 0 0 14px;
    max-width: 720px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--ink-mute);
  }
  .meta .minutes {
    order: 1;
  }
  .meta time {
    order: 0;
  }
  .meta .pill,
  .meta .term {
    order: 2;
  }
  .domain {
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }
  .term {
    position: relative;
    z-index: 1;
    color: var(--ink-mute);
    text-decoration: none;
  }
  .term:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  /* A saved site's screenshot (ADR 0055): beside the text in a row, across
     the top of a card. Outside the link, under its stretched overlay, so a
     click on it opens the site's page like the rest of the row. */
  .item.has-thumb {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 132px;
    column-gap: 22px;
  }
  .item.has-thumb > .item-link,
  .item.has-thumb > .meta {
    grid-column: 1;
  }
  .thumb {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    width: 132px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--wash);
  }
  /* The row's negative margin lives inside a ≥24px gutter; on phones the
     gutter is 16px, so the row sits flush instead. */
  @media (max-width: 39.99rem) {
    .item {
      margin: 0;
      padding: 20px 12px;
      border-radius: 0;
    }
    .item.has-thumb {
      grid-template-columns: minmax(0, 1fr) 88px;
      column-gap: 14px;
    }
    .thumb {
      width: 88px;
    }
  }

  :global(html[data-library-view="cards"]) .item {
    display: flex;
    flex-direction: column;
    margin: 0;
    min-height: 180px;
    padding: 20px 20px 16px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--field);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s;
  }
  :global(html[data-library-view="cards"]) .item:hover {
    background: var(--field);
    border-color: var(--ink-mute);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  :global(html[data-library-view="cards"]) .item.has-thumb {
    display: flex;
  }
  :global(html[data-library-view="cards"]) .thumb {
    order: -1;
    /* Past the card's padding to its edges, which preflight's
       \`img { max-width: 100% }\` would otherwise stop at the padding. */
    max-width: none;
    width: calc(100% + 40px);
    margin: -20px -20px 14px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 10px 10px 0 0;
  }
  :global(html[data-library-view="cards"]) .item-link {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
  }
  :global(html[data-library-view="cards"]) .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--ink-mute);
  }
  :global(html[data-library-view="cards"]) .top .domain {
    color: var(--ink-mute);
  }
  :global(html[data-library-view="cards"]) .title {
    margin: 0;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  :global(html[data-library-view="cards"]) .title-zh {
    margin: 0;
    font-size: 14px;
  }
  :global(html[data-library-view="cards"]) .summary {
    margin: 0;
    max-width: none;
    font-size: 13px;
    line-height: 1.75;
    -webkit-line-clamp: 3;
  }
  :global(html[data-library-view="cards"]) .meta {
    margin-top: auto;
    padding-top: 12px;
    gap: 4px;
    font-size: 12px;
  }
  :global(html[data-library-view="cards"]) .meta .minutes {
    order: 0;
  }
  :global(html[data-library-view="cards"]) .meta time {
    order: 1;
  }
  :global(html[data-library-view="cards"]) .meta time::before {
    content: "· ";
  }
  /* A site has no reading time for the date to follow. */
  :global(html[data-library-view="cards"]) .is-site .meta time::before {
    content: none;
  }
  :global(html[data-library-view="cards"]) .meta .domain,
  :global(html[data-library-view="cards"]) .meta .pill,
  :global(html[data-library-view="cards"]) .meta .term {
    display: none;
  }
</style>
