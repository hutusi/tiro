{
  "name": "@tiro/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.clipper.config.ts",
    "package": "bun run build && cd dist && rm -f ../tiro-clipper.zip && zip -qr ../tiro-clipper.zip . -x '.DS_Store' '**/.DS_Store'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@mozilla/readability": "^0.6.0",
    "@tiro/shared": "workspace:*",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/turndown": "^5.0.6",
    "vite": "^8.2.2"
  }
}
